# ==================================
# 生产环境配置文件模版:复制此文件为 .env.prod 并修改配置
# ==================================

ENVIRONMENT = "prod"

# 应用时区（IANA 名称，默认北京）
TIMEZONE = Asia/Shanghai

# 服务器配置
SERVER_HOST = 'localhost'     # 允许访问的IP地址0.0.0.0
SERVER_PORT = 8181          # 服务端口

# 文档配置
DEBUG = False                       # 调试模式
TITLE = "FssAdmin -prod"  # 文档标题
VERSION = '0.1.0'                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api"                  # API路由前缀
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = True

# 数据库配置
DATABASE_TYPE = "mysql"     # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = 3306  # MySQL:3306 PostgreSQL:5432
DATABASE_USER = "root"
DATABASE_PASSWORD = "root"
DATABASE_NAME = "fssoa-net"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = ''
REDIS_DB_NAME = 1

# Token 会话模式：jwt | redis-token
SESSION_TYPE = jwt

# 日志配置
LOGGER_LEVEL = 'INFO'

# ORM SQL 回显（生产建议保持关闭）
SQL_ECHO_CONSOLE=false
SQL_ECHO_FILE=false

# 大模型配置
OPENAI_BASE_URL = "https://api.minimax.chat"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-v4-flash"

# IP 归属地查询（登录时对外请求第三方 API，生产建议关闭）
IP_LOCATION_ENABLE=False

# ==================== 限流 ====================
# IP 全局限流总开关（默认关闭；开启后单 IP 每分钟最多 1000 请求）
RATE_LIMIT_ENABLED=false

# ==================== 调度器 ====================
# APScheduler（依赖 Redis JobStore；关闭则不启动）
SCHEDULER_ENABLE=false

# ==================== CORS ====================
ALLOWED_ORIGINS=https://your.frontend.domain,http://localhost:8181,http://localhost:5730

# ==================== 视频下载 ====================
VIDEO_DOWNLOAD_ROOT=static/videos
VIDEO_DOWNLOAD_WORKERS=2
VIDEO_META_WORKERS=1
VIDEO_META_RECOVER_ON_START=false
VIDEO_YTDLP_SUBPROCESS=true
# X/Twitter 登录态（只对这些站点生效）。cookie 文件优先。
# VIDEO_X_COOKIES_FILE=secrets/x_cookies.txt
# VIDEO_X_COOKIES_FROM_BROWSER=chrome

# ==================== 开发期内存诊断 ====================
# 仅排查时临时改 true，再手动请求 /api/core/server/monitor?diagnostics=true；平时必须关。
MEMORY_DIAGNOSTICS_ENABLE=false
