# ==================================
# 开发环境配置文件模版:复制此文件为 .env.dev 并修改配置
# ==================================

ENVIRONMENT = "dev"

# 服务器配置
SERVER_HOST = "localhost"     # 允许访问的IP地址
SERVER_PORT = 8001          # 服务端口

# 文档配置
DEBUG = True                        # 调试模式
TITLE = "FssAdmin -dev"    # 文档标题
VERSION = "1.0.0"                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api"               # API路由前缀
DESCRIPTION = "该项目是一个基于fastapi和sqlalchemy实现后台管理系统"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "mysql"  # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = 3306  # MySQL:3306 PostgreSQL:5432
DATABASE_USER = "root"
DATABASE_PASSWORD = "root"
DATABASE_NAME = "fssoa-net"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = ""
REDIS_DB_NAME = 1

# Token 会话模式：jwt | redis-token
SESSION_TYPE = jwt

# 日志配置
LOGGER_LEVEL = "DEBUG"   # 日志级别

# ORM SQL 回显（默认关）
# 控制台绿色打印每条 SQL
SQL_ECHO_CONSOLE=False
# 按天写入 logs/sql/sql_YYYY-MM-DD.log
SQL_ECHO_FILE=False

# 大模型配置
OPENAI_BASE_URL = "https://api.minimax.chat"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-v4-flash"

# IP 归属地查询（登录时对外请求第三方 API，生产建议关闭）
IP_LOCATION_ENABLE=False

# ==================== 限流 ====================
# IP 全局限流总开关（默认关闭；开启后单 IP 每分钟最多 1000 请求）
RATE_LIMIT_ENABLED=True

# ==================== 调度器 ====================
# APScheduler（依赖 Redis JobStore；关闭则不启动）
SCHEDULER_ENABLE=True

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:8181,http://localhost:5730

# ==================== 视频下载 ====================
VIDEO_DOWNLOAD_ROOT=static/videos
VIDEO_DOWNLOAD_WORKERS=2
VIDEO_META_WORKERS=1
VIDEO_META_RECOVER_ON_START=false
VIDEO_YTDLP_SUBPROCESS=true

# ==================== 开发期内存诊断 ====================
# 仅排查时临时改 true，再手动请求 /api/core/server/monitor?diagnostics=true；平时必须关。
MEMORY_DIAGNOSTICS_ENABLE=false